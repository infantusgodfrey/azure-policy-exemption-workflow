# ============================================================
# terraform.tfvars.example
#
# Copy this file:  cp terraform.tfvars.example terraform.tfvars
# Fill in your values below, then run:  terraform apply
#
# ⚠️  NEVER commit terraform.tfvars to source control.
#      It is already listed in .gitignore.
# ============================================================

# Your Azure Management Group ID
# Find it: az account management-group list --query "[].{name:name, displayName:displayName}"
management_group_id = "mg-contoso-root"

# Subscription where Logic App + Log Analytics are deployed
governance_subscription_id = "00000000-0000-0000-0000-000000000001"

# Dev team subscription (used in the walkthrough scenario)
dev_subscription_id = "00000000-0000-0000-0000-000000000002"

# Azure region
location = "eastus"

# Governance team email — receives approval requests and expiry alerts
approver_email = "governance-team@yourcompany.com"

# Log retention in days (default: 90)
log_retention_days = 90

# Days before exemption expiry to fire the alert (default: 7)
expiry_alert_days = 7

# Optional: override the default approved VM SKU list
# Leave empty to use the module defaults
# allowed_vm_skus = ["Standard_D2s_v3", "Standard_D4s_v3"]
